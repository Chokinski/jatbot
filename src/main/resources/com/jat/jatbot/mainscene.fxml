<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane fx:id="bp" onMouseDragged="#onDragged" onMousePressed="#onPressed" prefHeight="237.0" prefWidth="431.0" style="-fx-background-radius: 20; -fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jat.jatbot.ui.Controller">
   <center>
      <AnchorPane id="splashLogin" focusTraversable="true" maxHeight="237.0" maxWidth="409.0" minHeight="237.0" minWidth="409.0" prefHeight="237.0" prefWidth="409.0" stylesheets="@styles.css">
         <children>
            <ImageView fitHeight="116.0" fitWidth="204.0" layoutX="147.0" layoutY="-10.0" pickOnBounds="true" preserveRatio="true" styleClass="mainWindow">
               <image>
                  <Image url="@maaain.png" />
               </image>
            </ImageView>
            <JFXButton fx:id="btnLogin" buttonType="RAISED" layoutX="179.0" layoutY="194.0" onAction="#onBtnLogin" styleClass="btnAccent" text="Login" />
            <Button fx:id="btnLightMode" layoutX="243.0" layoutY="194.0" mnemonicParsing="false" onAction="#btnLightSwitch" style="-fx-background-color: transparent;" styleClass="btnAccent" text="Dim it down" />
            <JFXPasswordField fx:id="tfSec_ID" focusColor="#dfc6ba" labelFloat="true" layoutX="51.0" layoutY="156.0" prefHeight="25.0" prefWidth="302.0" promptText="Paste secret key..." style="-fx-text-color: F6F6F4;" styleClass="accent" stylesheets="@styles.css" />
            <JFXTextField fx:id="tfKey_ID" focusColor="#dfc6ba" layoutX="51.0" layoutY="106.0" prefHeight="25.0" prefWidth="302.0" promptText="Enter Key id..." style="-fx-text-fill: F6F6F4;" />
            <JFXCheckBox fx:id="chkRemember" checkedColor="#8a7d78" layoutX="35.0" layoutY="198.0" onAction="#onRememberMe" prefHeight="18.0" prefWidth="122.0" text="Remember Me" />
         </children>
         <styleClass>
            <String fx:value="root" />
            <String fx:value="mainWindow" />
         </styleClass>
      </AnchorPane>
   </center>
   <top>
      <AnchorPane prefHeight="17.0" prefWidth="431.0" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER" />
   </top>
   <bottom>
      <AnchorPane prefHeight="18.0" prefWidth="431.0" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER" />
   </bottom>
   <left>
      <AnchorPane prefHeight="237.0" prefWidth="14.0" BorderPane.alignment="CENTER" />
   </left>
   <right>
      <AnchorPane prefHeight="237.0" prefWidth="14.0" BorderPane.alignment="CENTER" />
   </right>
</BorderPane>
